{
  "expo": {
    "name": "kakitome",
    "slug": "kakitome",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kakitome",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.kakitome",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00897B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.kakitome",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00897B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Checklist",
              "label": "kakitome チェックリスト",
              "description": "メモのチェックリストを表示・操作",
              "minWidth": "180dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "メモに添付する画像を選ぶために、写真ライブラリへアクセスします。"
        }
      ],
      "./plugins/withIosScene",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.196889256232-0r0vqbt26up91kaj7ktlne3of3n4i8nc"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.kakitome.ExpoWidgetsTarget",
          "groupIdentifier": "group.app.kakitome",
          "widgets": [
            {
              "name": "Checklist",
              "displayName": "kakitome チェックリスト",
              "description": "メモのチェックリストを表示",
              "supportedFamilies": [
                "systemMedium",
                "systemLarge"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "donchan",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5c13dfe-1ead-4491-949b-702eac257bd2"
      }
    }
  }
}
